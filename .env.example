# x-tweet-nuker configuration.
# Every value here is optional - all of them have a command-line flag that wins over the
# environment, and a sensible default if neither is given.
# Copy this file to .env in the directory you run the tool from.

# Your X handle, without the leading "@".
# Normally detected automatically from the logged-in session; set this only if detection fails.
# This is not an override: before deleting anything, the handle is checked against the account X
# says the session signs in as, and a mismatch aborts the run rather than picking one.
X_HANDLE=

# Directory that holds the session file, run state, logs and the browser profile.
# Default: the current working directory.
X_NUKER_DATA_DIR=

# Path to the tweets.js file from your Twitter/X data archive (or a directory containing it).
# Default: <data dir>/tweets.js
ARCHIVE_FILE=

# Explicit paths for the individual state files. Default: inside the data directory.
SESSION_FILE=
STATE_FILE=
LOG_FILE=

# Milliseconds to wait between deletions. Lower is faster but hits the rate limit sooner.
# Default: 400
DELETE_DELAY_MS=

# Stop after N deletions. 0 or empty means no limit.
# Default: 0
LIMIT=

# Maximum number of sweep rounds before giving up on reaching a clean pass.
# Must be 1 or more - 0 is rejected, not silently replaced by the default.
# Default: 30
MAX_ROUNDS=

# Comma-separated tweet ids that `verify` should look up individually, in addition to scanning
# your profile tabs. Same as `verify --ids <a,b,c>`.
# Default: empty
CHECK_IDS=

# Run the browser headless. "1"/"true" to force on, "0"/"false" to force off.
# Default: off for `login` (you need to see the login form), on for `verify`.
HEADLESS=

# Absolute path to a Chrome/Chromium binary. Leave empty to use Playwright's bundled Chromium.
CHROME_EXECUTABLE=
